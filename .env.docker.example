# Compose/image settings
ECOMMERCE_CONTENT_VERSION=3.1.0
ECOMMERCE_CONTENT_PORT=8000

# Windows Docker Desktop example. Use forward slashes in Compose environment files.
ECOMMERCE_CONTENT_DATA_DIR=D:/docker-data/ecommerce-content-platform/runtime

# Leave empty to use the SQLite database under the persistent runtime directory.
PVA_WORKBENCH_DATABASE_URL=

# A ComfyUI service running on the Docker host can be reached through this name.
PVA_COMFYUI_BASE_URL=http://host.docker.internal:8188
PVA_AUTH_SESSION_HOURS=24
PVA_MEDIA_PROBE_TIMEOUT_SECONDS=60
